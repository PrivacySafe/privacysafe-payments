{
  "name": "privacysafe-paid-access-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Secret Agent Club paid access: Solana Pay with a derived reference, USDC or AUDD. Proof of concept for PrivacySafe Chat paid groups.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild client/app.js --bundle --splitting --minify --format=esm --target=es2020 --legal-comments=linked --outdir=public/js --chunk-names=chunks/[name]-[hash] --metafile=build/meta.json && node scripts/notices.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "npm run build && npm start",
    "check-address": "node scripts/check-address.js",
    "test": "node tests/reference.mjs && tools/walkthrough/serve-demo.sh bash -c 'node tests/abuse.mjs && node tests/front.mjs && node tests/header.mjs && node tests/csp.mjs && node tests/a11y.mjs && node tests/flows.mjs 390 844 device && node tests/flows.mjs 390 844 device-x402 x402 && node tests/flows.mjs 1920 1080 desktop'",
    "videos": "tools/walkthrough/make-videos.sh"
  },
  "dependencies": {
    "@solana-program/token": "0.9.0",
    "@solana-program/token-2022": "0.6.1",
    "@solana/kit": "5.5.1",
    "@wallet-standard/app": "1.1.0",
    "@x402/core": "2.26.0",
    "@x402/evm": "2.26.0",
    "@x402/express": "2.26.0",
    "@x402/svm": "2.26.0",
    "express": "4.22.3",
    "qrcode": "1.5.4",
    "viem": "2.56.9"
  },
  "optionalDependencies": {
    "@coinbase/x402": "2.1.0"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.56.0",
    "follow-redirects": "1.16.0"
  },
  "author": "Ivy Cyber LLC <https://ivycyber.com>",
  "contributors": [
    "Mikalai Birukou <mb@3nsoft.com>",
    "Sean O'Brien <sean@ivycyber.com>",
    "3NSoft, Inc. <https://3nsoft.com>",
    "PrivacySafe Foundation, Inc. <https://privacysafe.foundation>"
  ]
}
